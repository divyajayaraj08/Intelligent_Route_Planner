MONGODB_URI=mongodb+srv://<db_user>:<url_encoded_password>@<cluster-host>.mongodb.net/smartroute?retryWrites=true&w=majority
PORT=5000
# Optional: TomTom Orbis Routing API v3 key for live traffic-aware routing.
# Obtain a key from a TomTom developer account; keep it server-side only.
TOMTOM_API_KEY=
# Optional contact email used to identify higher-volume Nominatim requests.
NOMINATIM_CONTACT=